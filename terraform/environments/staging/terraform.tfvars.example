aws_region = "ap-southeast-2"

project_name = "aws-kubernetes-devsecops-platform"

environment = "staging"

vpc_cidr = "10.1.0.0/16"

availability_zones = [
  "ap-southeast-2a",
  "ap-southeast-2b"
]

public_subnet_cidrs = [
  "10.1.1.0/24",
  "10.1.2.0/24"
]

private_subnet_cidrs = [
  "10.1.11.0/24",
  "10.1.12.0/24"
]

# Keep staging lightweight while still allowing basic scaling tests.
instance_type    = "t3.micro"
min_size         = 1
desired_capacity = 1
max_size         = 2

# Staging remains disposable and easy to recreate.
enable_alb_deletion_protection = false

# Keep staging logs longer because this environment is closer to production.
alb_log_retention_days = 60
