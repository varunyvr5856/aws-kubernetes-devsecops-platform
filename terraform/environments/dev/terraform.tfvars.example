aws_region = "ap-southeast-2"

project_name = "aws-kubernetes-devsecops-platform"

environment = "dev"

vpc_cidr = "10.0.0.0/16"

availability_zones = [
  "ap-southeast-2a",
  "ap-southeast-2b"
]

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

private_subnet_cidrs = [
  "10.0.11.0/24",
  "10.0.12.0/24"
]

# Small compute footprint for the dev environment to reduce AWS cost.
instance_type    = "t3.micro"
min_size         = 1
desired_capacity = 1
max_size         = 2

# Dev is intentionally easy to tear down when not in use.
enable_alb_deletion_protection = false

# Dev access logs only need short-term retention for troubleshooting.
alb_log_retention_days = 30
