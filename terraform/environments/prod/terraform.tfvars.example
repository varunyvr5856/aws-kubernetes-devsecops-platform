aws_region = "ap-southeast-2"

project_name = "aws-kubernetes-devsecops-platform"

environment = "prod"

vpc_cidr = "10.2.0.0/16"

availability_zones = [
  "ap-southeast-2a",
  "ap-southeast-2b"
]

public_subnet_cidrs = [
  "10.2.1.0/24",
  "10.2.2.0/24"
]

private_subnet_cidrs = [
  "10.2.11.0/24",
  "10.2.12.0/24"
]

# Production keeps a higher baseline capacity for availability.
instance_type    = "t3.micro"
min_size         = 2
desired_capacity = 2
max_size         = 4

# Protect the production ALB from accidental deletion.
enable_alb_deletion_protection = true

# Retain production ALB logs longer for operational and security investigations.
alb_log_retention_days = 90
